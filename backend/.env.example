# Django Security & Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-genzicon-foundation-secret-key-change-in-prod-xyz987

# Database Type: mysql | postgresql | sqlite
DB_ENGINE=mysql

# MySQL / PostgreSQL Connection (When DB_ENGINE=mysql or postgresql)
DB_NAME=genzicon_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
